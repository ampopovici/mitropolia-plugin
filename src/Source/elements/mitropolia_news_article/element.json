{
 "name": "mitropolia_news_article",
 "title": "News article",
 "group": "Mitropolia",
 "icon": "${url:images/icon.svg}",
 "iconSmall": "${url:images/icon-small.svg}",
 "element": true,
 "width": 500,
 "defaults": {},
 "templates": {
  "render": "./templates/template.php",
  "content": "./templates/content.php"
 },
 "fields": {
  "article_id": {
   "label": "Article ID",
   "description": "Leave empty: the page shows the article being viewed. Enter an ID only to preview an article in the builder."
  },
  "class": {
   "label": "Class",
   "description": "Optional extra CSS class."
  },
  "part": {
   "label": "Show",
   "type": "select",
   "options": {
    "Everything (header included)": "",
    "Article body only": "body"
   },
   "description": "Article body only leaves out the breadcrumb, date, title and lead photo, so the page header can be built with YOOtheme elements."
  }
 },
 "fieldset": {
  "default": {
   "type": "tabs",
   "fields": [
    {
     "title": "Content",
     "fields": [
      "part",
      "article_id"
     ]
    },
    {
     "title": "Advanced",
     "fields": [
      "class"
     ]
    }
   ]
  }
 }
}