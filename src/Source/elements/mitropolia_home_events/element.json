{
 "name": "mitropolia_home_events",
 "title": "Homepage: events",
 "group": "Mitropolia",
 "icon": "${url:images/icon.svg}",
 "iconSmall": "${url:images/icon-small.svg}",
 "element": true,
 "width": 500,
 "defaults": {
  "count": 4
 },
 "templates": {
  "render": "./templates/template.php",
  "content": "./templates/content.php"
 },
 "fields": {
  "kicker": {
   "label": "Small title",
   "description": "Leave empty for the standard wording in the page language."
  },
  "title": {
   "label": "Title",
   "description": "Leave empty for the standard wording in the page language."
  },
  "count": {
   "label": "Number of events",
   "type": "number",
   "description": "Cards per tab (default 4)."
  },
  "class": {
   "label": "Extra CSS class",
   "description": "Optional."
  }
 },
 "fieldset": {
  "default": {
   "type": "tabs",
   "fields": [
    {
     "title": "Content",
     "fields": [
      "kicker",
      "title",
      "count",
      "class"
     ]
    }
   ]
  }
 }
}