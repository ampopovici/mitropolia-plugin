{
 "name": "mitropolia_search",
 "title": "Search results",
 "group": "Mitropolia",
 "icon": "${url:images/icon.svg}",
 "iconSmall": "${url:images/icon-small.svg}",
 "element": true,
 "width": 500,
 "defaults": {},
 "templates": {
  "render": "./templates/template.php",
  "content": "./templates/content.php"
 },
 "fields": {
  "title": {
   "label": "Title",
   "description": "Leave empty for Căutare / Search / Búsqueda."
  },
  "class": {
   "label": "Class",
   "description": "Optional extra CSS class."
  },
  "part": {
   "label": "Show",
   "type": "select",
   "options": {
    "Everything (header included)": "",
    "Intro line only (empty after a search)": "intro",
    "Search box only": "search",
    "Group buttons only": "chips",
    "Results only": "body"
   },
   "description": "The page header (breadcrumb, title, intro) is built with YOOtheme elements; this block then shows only the part chosen here."
  }
 },
 "fieldset": {
  "default": {
   "type": "tabs",
   "fields": [
    {
     "title": "Content",
     "fields": [
      "part",
      "title"
     ]
    },
    {
     "title": "Advanced",
     "fields": [
      "class"
     ]
    }
   ]
  }
 }
}