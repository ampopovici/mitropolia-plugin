{
 "name": "mitropolia_media_item",
 "title": "Media item",
 "group": "Mitropolia",
 "icon": "${url:images/icon.svg}",
 "iconSmall": "${url:images/icon-small.svg}",
 "element": true,
 "width": 500,
 "defaults": {},
 "templates": {
  "render": "./templates/template.php",
  "content": "./templates/content.php"
 },
 "fields": {
  "class": {
   "label": "Class",
   "description": "Optional extra CSS class."
  },
  "part": {
   "label": "Show",
   "type": "select",
   "options": {
    "Everything (header included)": "",
    "Without the breadcrumb band": "body"
   },
   "description": "The page header (breadcrumb, title, intro) is built with YOOtheme elements; this block then shows only the part chosen here."
  }
 },
 "fieldset": {
  "default": {
   "type": "tabs",
   "fields": [
    {
     "title": "Media item",
     "fields": [
      "part",
      "class"
     ]
    }
   ]
  }
 }
}